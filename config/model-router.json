  "domainTiering": {
    "description": "Per-domain quality tier for business agents (M6). finance/legal are correctness-critical -> premium (low temperature, high guard). Marketing/sales are creative -> balanced. Determined by domain risk, mirrored in config/agents.json temperatures.",
    "tiers": {
      "premium": {
        "domains": ["finance", "legal", "gov"],
        "temperature": 0.1,
        "hallucinationGuard": "critical",
        "rationale": "Financial models must balance; legal output escalates on doubt. Zero tolerance for hallucination."
