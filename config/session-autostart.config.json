{
  "version": "1.0.0",
  "name": "session-autostart-config",
  "description": "Configuration for session autostart pipeline - controls which steps run and their parameters",
  "pipeline": {
    "steps": [
      {
        "id": "legacy-registration-cleanup",
        "enabled": true,
        "script": "src/core/legacy-registration-cleanup.ts",
        "required": false,
        "phase": 1,
        "skipOnFailure": true,
        "timeout": 20000,
        "description": "Limpieza de registros OS huerfanos (PS1->TS migration): Run keys y scheduled tasks apuntando a scripts borrados causaban ventanas cmd/pwsh fantasma visibles. Best-effort: tareas elevadas se reintentan cada sesion."
      },
      {
        "id": "process-hygiene",
        "enabled": true,
        "script": "src/core/process-hygiene.ts",
        "args": "--apply --quiet",
        "required": false,
        "critical": true,
        "phase": 1,
        "skipOnFailure": true,
        "timeout": 30000,
        "retries": 1,
        "retryDelay": 1000,
        "description": "Higiene nativa de procesos (fase 1, ANTES de los lazy daemons): recicla daemons envejecidos (>24h adoptados de sesiones previas), mata duplicados (websocket-server/vite extra), one-shots colgados (padre muerto >15min) y limpia pidfiles stale. Clave: corre antes de los lazy steps, asi token-ingest y vite-watchdog reciclados se re-spawnean frescos."
      },
      {
        "id": "model-enforcer",
        "enabled": true,
        "script": "src/ml/model-enforcer.ts",
        "args": "--apply",
        "required": true,
        "critical": true,
        "phase": 0,
        "description": "Enforce free model (opencode/mimo-v2.5-free) when credits exhausted"
      },
      {
        "id": "tool-detection",
        "enabled": true,
        "script": "src/core/detect-tool.ts",
        "args": "--json",
        "required": false,
        "description": "Detect AI tool/agent and load tool-specific configuration (TS)"
      },
      {
        "id": "bootstrap-symlink",
        "enabled": true,
        "script": "src/infrastructure/bootstrap-symlink.ts",
        "args": "",
        "required": true,
        "critical": true,
        "phase": 0,
        "description": "Auto-create @gentle-vanguard/core symlink for module resolution"
      },
      {
        "id": "session-manager",
        "enabled": true,
        "script": "src/session/session-cleanup-start.ts",
        "args": "--quiet --skip-cache-flush --skip-compression",
        "required": true,
        "critical": true,
        "phase": 0,
        "description": "Initialize session ID and create session file (TS)"
      },
      {
        "id": "session-cleanup",
        "enabled": true,
        "lazy": true,
        "script": "src/session/session-cleanup-start.ts",
        "args": "-Quiet -SkipSessionInit -SkipCacheFlush",
        "required": false,
        "description": "Cleanup ligero al inicio (lazy): remueve sesiones stale >8h y cierra sesiones huerfanas. -SkipSessionInit impide regenerar la sesion que session-manager (phase 0) ya creo; -SkipCacheFlush evita resetear los caches de tokens que el daemon token-ingest esta escribiendo."
      },
      {
        "id": "session-retention",
        "enabled": true,
        "lazy": true,
        "script": "src/session/session-retention.ts",
        "args": "prune",
        "required": false,
        "phase": 95,
        "description": "Session retention - prune old sessions, checkpoints, backups according to retention policy (max 10 sessions, 5 checkpoints, 3 backups)"
      },
      {
        "id": "github-bypass",
        "enabled": true,
        "script": "src/infrastructure/ensure-github-bypass.ts",
        "args": "--owner EmmanuelOrtiz87 --branch develop",
        "required": false,
        "description": "Ensure GitHub bypass policy for current user (TS)"
      },
      {
        "id": "notifications",
        "enabled": true,
        "script": "src/session/session-notification.ts",
        "args": "--timezone \"America/Argentina/Buenos_Aires\" --peak-start 9 --peak-end 15 --region \"Argentina\"",
        "required": false,
        "description": "Time-based peak hour notifications (TS)"
      },
      {
        "id": "auth-session",
        "enabled": false,
        "script": "src/security/auth-session.ts",
        "args": "",
        "required": false,
        "description": "Authenticate owner for restricted operations (TS)",
        "note": "Disabled by default - auth is demand-driven, not at session start. Enable if session-level auth is required."
      },
      {
        "id": "engram-policy",
        "enabled": true,
        "script": "src/knowledge/engram-policy.ts",
        "args": "",
        "required": true,
        "critical": true,
        "description": "Verify Engram is installed and running (TS)"
      },
      {
        "id": "token-budget",
        "enabled": true,
        "script": "src/tokens/token-budget-guard.ts",
        "args": "-Task session-start -Risk low -Record -ActualPromptTokens 0 -ActualCompletionTokens 0",
        "required": false,
        "description": "Record session start for token budget tracking"
      },
