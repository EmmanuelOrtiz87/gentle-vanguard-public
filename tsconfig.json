{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "adapters/**/*.ts",
    "packages/shared/src/**/*.ts",
    "scripts/*.ts",
    "scripts/mcp/**/*.ts",
    "scripts/debug/**/*.ts",
    "scripts/recovery/**/*.ts",
    "scripts/database/**/*.ts",
    "scripts/utilities/ops/REVIEW/**/*.ts",
    "scripts/utilities/security/**/*.ts",
    "scripts/utilities/MODEL-ROUTER/**/*.ts",
    "scripts/validation/**/*.ts",
    "src/**/*.ts",
    "scripts/apps/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "coverage", "templates", "src/convergence"]
}
