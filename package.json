{
  "type": "module",
  "version": "3.3.3",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "pnpm": ">=11.0.0",
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "pwsh ./scripts/run-tests-simple.ps1",
    "lint:json": "pwsh ./hooks/json-lint.ps1",
    "lint:workflows": "pwsh ./hooks/workflow-lint.ps1",
    "lint": "eslint \"scripts/**/*.ts\" \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"scripts/**/*.ts\" \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "format:check": "pnpm prettier --check \"**/*.{md,json,yml,yaml}\" ",
    "format:fix": "pnpm prettier --write \"**/*.{md,json,yml,yaml}\" ",
    "prepare": "pnpm lefthook install",
    "coverage": "c8 --reporter=text --reporter=lcov --reporter=html node --test \"tests/**/*.spec.js\"",
    "secretlint": "secretlint \"**/*.{json,yml,yaml,md,env,toml,xml}\" --secretlintrc .secretlintrc.json",
    "build:mcp": "pnpm tsc",
    "build:mcp:watch": "pnpm tsc --watch",
    "mcp:start": "node dist/scripts/mcp/skill-server.js",
    "mcp:test": "pwsh scripts/health-check/health-check.ps1 -Component mcp",
    "team:run": "pwsh scripts/team-mode/team-orchestrator.ps1",
    "sdd:run": "pwsh scripts/sdd-pipeline/sdd-pipeline.ps1",
    "session:index": "pwsh scripts/utilities/session/session-reference-system.ps1 -Mode index",
    "session:guide": "pwsh scripts/utilities/session/session-reference-system.ps1 -Mode guide",
    "factory:run": "pwsh scripts/utilities/skill-factory/skill-factory.ps1",
    "health:check": "pwsh scripts/health-check/health-check.ps1",
    "health:check:quiet": "pwsh scripts/health-check/health-check.ps1 -Quiet",
    "update:check": "pwsh scripts/utilities/utils/check-version.ps1",
    "update:run": "pwsh scripts/utilities/utils/auto-update.ps1",
    "docker:build": "docker build -t gentle-vanguard .",
    "docker:test": "docker compose -f docker-compose.test.yml up --abort-on-container-exit",
    "test:integration": "node --test tests/integration/api-health.test.js",
    "dashboard:build": "cd apps/web-dashboard && pnpm build",
    "dashboard:dev": "cd apps/web-dashboard && pnpm dev",
    "dashboard:server": "node apps/web-dashboard/server/websocket-server.ts",
    "postinstall": "pnpm build:mcp"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.30.0",
    "@typescript-eslint/parser": "^8.30.0",
    "better-sqlite3": "^12.10.0",
    "c8": "^10.1.3",
    "eslint": "^8.57.0",
    "lefthook": "^2.1.8",
    "prettier": "^3.0.0",
    "secretlint": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.1.3",
    "@playwright/test": "^1.54.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
